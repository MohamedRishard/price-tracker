# Database Connection (Neon Serverless PostgreSQL or local fallback)
# Neon connection string format: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Resend API Configuration (Official Resend SDK)
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Email Notification Recipient
ALERT_RECIPIENT_EMAIL=your-email@example.com

# Optional Server Settings
PORT=8000
HOST=0.0.0.0
